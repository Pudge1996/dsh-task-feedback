{
  "name": "dsh-task-feedback",
  "version": "0.2.1",
  "description": "Tab favicon indicator and synthesised notification sounds for DeepSeek Harness — glance at the tab to see whether a session is running, waiting for you, or done.",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "pnpm run build"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "favicon",
    "status",
    "indicator",
    "notification",
    "sound",
    "web-audio",
    "desktop"
  ],
  "license": "MIT",
  "author": "Pudge1996",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pudge1996/dsh-task-feedback"
  },
  "devDependencies": {
    "tsdown": "^0.22.14"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}